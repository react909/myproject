{
  "name": "desktop",
  "private": true,
  "version": "1.1.1",
  "description": "Kassir ERP — fully local POS (Electron + FastAPI + SQLite).",
  "author": "Cursor Agent",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:electron\"",
    "build:web": "tsc && vite build",
    "test": "node scripts/run-tests.mjs",
    "build": "npm run build:web",
    "preview": "vite preview",
    "make": "npm run dist",
    "dist": "npm run icons:win && npm run build:web && electron-builder --win nsis portable && node scripts/verify-packaged-receipt.mjs",
    "dist:backend": "powershell -ExecutionPolicy Bypass -File ../backend/build.ps1",
    "dist:full": "npm run dist:backend && npm run dist",
    "dist:dir": "npm run icons:win && npm run build:web && electron-builder --dir && node scripts/verify-packaged-receipt.mjs",
    "dist:portable": "npm run dist:dir",
    "icons:win": "node scripts/build-win-icon.mjs",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "axios": "^1.13.1",
    "electron-updater": "^6.6.2",
    "framer-motion": "^12.23.24",
    "iconv-lite": "^0.6.3",
    "jsqr": "^1.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-easy-crop": "^5.0.8",
    "react-router-dom": "^7.14.2",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^2.1.8",
    "typescript": "~6.0.2",
    "vite": "^8.0.4",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.nurcrm.manablock",
    "productName": "Kassir ERP",
    "directories": {
      "buildResources": "build-resources",
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/**/*.map",
      "!**/*.md",
      "!**/.DS_Store"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/@serialport/**",
      "**/node_modules/serialport/**"
    ],
    "extraResources": [
      {
        "from": "build-resources/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "../backend/dist/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [],
    "win": {
      "icon": "build-resources/icon.ico",
      "executableName": "NurCRM-Manablock",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "NurCRM-Manablock-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Kassir ERP",
      "installerIcon": "build-resources/icon.ico",
      "uninstallerIcon": "build-resources/icon.ico",
      "installerHeaderIcon": "build-resources/icon.ico",
      "include": "build/installer.nsh",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "guid": "a8f3c2e1-9b4d-4f6a-8c1d-2e4f6a7b8c9d"
    }
  }
}
